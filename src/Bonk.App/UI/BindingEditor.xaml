<Window x:Class="Bonk.App.UI.BindingEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Bonk — edit binding" Width="520" Height="550"
        Style="{StaticResource {x:Type Window}}" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Give a tap something to do." FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20" />
      <TextBlock Text="Gesture" Margin="0,0,0,7" /><ComboBox x:Name="TriggerBox" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="Gesture" />
      <TextBlock Text="Action" Margin="0,18,0,7" /><ComboBox x:Name="ActionBox" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="ActionChanged" AutomationProperties.Name="Action type" />
      <TextBlock x:Name="ValueLabel" Text="Shortcut" Margin="0,18,0,7" />
      <TextBox x:Name="ValueBox" PreviewKeyDown="RecordShortcut" AutomationProperties.Name="Shortcut or action" />
      <ComboBox x:Name="ChoiceBox" Visibility="Collapsed" AutomationProperties.Name="Media key or mouse button" />
      <TextBlock x:Name="HelpText" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,9,0,0" />
      <StackPanel x:Name="ArgumentsPanel" Visibility="Collapsed" Margin="0,15,0,0"><TextBlock Text="Arguments (optional)" Margin="0,0,0,7" /><TextBox x:Name="ArgumentsBox" AutomationProperties.Name="Application arguments" /></StackPanel>
      <TextBlock x:Name="ErrorText" Foreground="#FFA29B" TextWrapping="Wrap" Margin="0,15,0,0" />
    </StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Button x:Name="DeleteButton" Content="Remove" Click="DeleteBinding" HorizontalAlignment="Left" />
      <Button Grid.Column="1" Content="Cancel" IsCancel="True" Margin="0,0,10,0" />
      <Button Grid.Column="2" Content="Save binding" Click="SaveBinding" IsDefault="True" Background="{StaticResource AccentBrush}" Foreground="#151C24" />
    </Grid>
  </Grid>
</Window>
